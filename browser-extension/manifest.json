{
	"$schema": "https://json.schemastore.org/chrome-manifest",
	"manifest_version": 3,
	"name": "Quick Edits",
	"description": "Quickly edit websites and find the locations in code.",
	"version": "0.0.0",
	"devtools_page": "devtools.html",
	"options_ui": {
		"page": "options.html"
	},
	"action": {
		"default_icon": {
			"16": "icon16.png",
			"32": "icon32.png"
		},
		"default_popup": "popup.html"
	},
	"background": {
		"service_worker": "src/background.ts"
	},
	"commands": {
		"toggle-inspect": {
			"suggested_key": {
				"default": "Alt+J",
				"mac": "Alt+J"
			},
			"description": "Toggle element inspection"
		}
	},
	"permissions": ["storage", "nativeMessaging", "activeTab", "scripting"],
	"web_accessible_resources": [
		{
			"resources": ["manifest.json"],
			"matches": ["<all_urls>"]
		}
	]
}
